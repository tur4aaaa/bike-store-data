{\rtf1\deff0{\fonttbl{\f0 Calibri;}{\f1 Times New Roman;}}{\colortbl ;\red0\green0\blue255 ;}{\*\defchp \f1}{\*\defpap \sl275\slmult1\sa200}{\stylesheet {\ql\sl275\slmult1\sa200\f1 Normal;}{\*\cs1\f1 Default Paragraph Font;}{\*\cs2\sbasedon1\f1 Line Number;}{\*\cs3\ul\f1\cf1 Hyperlink;}{\*\ts4\tsrowd\f1\ql\sl275\slmult1\sa200\tscellpaddfl3\tscellpaddl108\tscellpaddfb3\tscellpaddfr3\tscellpaddr108\tscellpaddft3\tsvertalt\cltxlrtb Normal Table;}{\*\ts5\tsrowd\sbasedon4\f1\ql\sl275\slmult1\sa200\trbrdrt\brdrs\brdrw10\trbrdrl\brdrs\brdrw10\trbrdrb\brdrs\brdrw10\trbrdrr\brdrs\brdrw10\trbrdrh\brdrs\brdrw10\trbrdrv\brdrs\brdrw10\tscellpaddfl3\tscellpaddl108\tscellpaddfr3\tscellpaddr108\tsvertalt\cltxlrtb Table Simple 1;}}{\*\listoverridetable}\nouicompat\splytwnine\htmautsp\sectd\pard\plain\ql{\f1\cf0 CREATE TABLE supplier (}\f1\par\pard\plain\ql{\f1\cf0     id SERIAL PRIMARY KEY,          }\f1\par\pard\plain\ql{\f1\cf0     name VARCHAR(100) NOT NULL,     }\f1\par\pard\plain\ql{\f1\cf0     contact_name VARCHAR(100),     }\f1\par\pard\plain\ql{\f1\cf0     city VARCHAR(50) }\f1\par\pard\plain\ql{\f1\cf0 );}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 REATE TABLE purchase_order (}\f1\par\pard\plain\ql{\f1\cf0     id SERIAL PRIMARY KEY,        }{\f1\cf0 \tab }\f1\par\pard\plain\ql{\f1\cf0     store_id INT NOT NULL,          }\f1\par\pard\plain\ql{\f1\cf0     supplier_id INT NOT NULL,      }\f1\par\pard\plain\ql{\f1\cf0     order_date DATE NOT NULL,       }\f1\par\pard\plain\ql{\f1\cf0     expected_delivery DATE,         }\f1\par\pard\plain\ql{\f1\cf0     actual_delivery DATE,           }\f1\par\pard\plain\ql{\f1\cf0     FOREIGN KEY (supplier_id) REFERENCES supplier(id)}\f1\par\pard\plain\ql{\f1\cf0 );}\f1\par\pard\plain\ql{\f1\cf0 CREATE TABLE purchase_order_item (}\f1\par\pard\plain\ql{\f1\cf0     id SERIAL PRIMARY KEY,}\f1\par\pard\plain\ql{\f1\cf0     purchase_order_id INT NOT NULL,}\f1\par\pard\plain\ql{\f1\cf0     product_id INT NOT NULL,}\f1\par\pard\plain\ql{\f1\cf0     quantity INT NOT NULL,}\f1\par\pard\plain\ql{\f1\cf0     unit_cost NUMERIC(10,2) NOT NULL,}\f1\par\pard\plain\ql{\f1\cf0     line_total NUMERIC(10,2),}\f1\par\pard\plain\ql{\f1\cf0     FOREIGN KEY (purchase_order_id) REFERENCES purchase_order(id)}\f1\par\pard\plain\ql{\f1\cf0 );}\f1\par\pard\plain\ql{\f1\cf0 CREATE TABLE delivery_service (}\f1\par\pard\plain\ql{\f1\cf0     id SERIAL PRIMARY KEY,}\f1\par\pard\plain\ql{\f1\cf0     name VARCHAR(100) NOT NULL,      }\f1\par\pard\plain\ql{\f1\cf0     city VARCHAR(50)}\f1\par\pard\plain\ql{\f1\cf0 );}\f1\par\pard\plain\ql{\f1\cf0 CREATE TABLE shipment (}\f1\par\pard\plain\ql{\f1\cf0     id SERIAL PRIMARY KEY,}\f1\par\pard\plain\ql{\f1\cf0     order_id INT NOT NULL,          }\f1\par\pard\plain\ql{\f1\cf0     delivery_service_id INT NOT NULL,}\f1\par\pard\plain\ql{\f1\cf0     ship_date DATE,                 }\f1\par\pard\plain\ql{\f1\cf0     expected_arrival DATE,           }\f1\par\pard\plain\ql{\f1\cf0     actual_arrival DATE,            }\f1\par\pard\plain\ql{\f1\cf0     tracking_number VARCHAR(50),}\f1\par\pard\plain\ql{\f1\cf0     shipping_cost NUMERIC(10,2),}\f1\par\pard\plain\ql{\f1\cf0     status VARCHAR(50),             }\f1\par\pard\plain\ql{\f1\cf0     FOREIGN KEY (order_id) REFERENCES purchase_order(id),}\f1\par\pard\plain\ql{\f1\cf0     FOREIGN KEY (delivery_service_id) REFERENCES delivery_service(id)}\f1\par\pard\plain\ql{\f1\cf0 );}\f1\par\pard\plain\ql\f1\par\pard\plain\ql\f1\par\pard\plain\ql\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 INSERT INTO supplier (name, contact_name, city) VALUES}\f1\par\pard\plain\ql{\f1\cf0 ('Velopostach', 'Ivan Ivanov', 'Kyiv'),}\f1\par\pard\plain\ql{\f1\cf0 ('Ukrainian Wheels', 'Petro Petrenko', 'Lviv'),}\f1\par\pard\plain\ql{\f1\cf0 ('DniproVelo', 'Maria Koval', 'Dnipro');}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 INSERT INTO delivery_service (name, city) VALUES}\f1\par\pard\plain\ql{\f1\cf0 ('Nova Poshta', 'Kyiv'),}\f1\par\pard\plain\ql{\f1\cf0 ('Ukrposhta', 'Lviv'),}\f1\par\pard\plain\ql{\f1\cf0 ('Delivery UA', 'Odesa');}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 INSERT INTO purchase_order_item (purchase_order_id, product_id, quantity, unit_cost, line_total) VALUES}\f1\par\pard\plain\ql{\f1\cf0 (1, 101, 10, 150.00, 1500.00),}\f1\par\pard\plain\ql{\f1\cf0 (1, 102, 5, 200.00, 1000.00),}\f1\par\pard\plain\ql{\f1\cf0 (2, 103, 3, 300.00, 900.00),}\f1\par\pard\plain\ql{\f1\cf0 (2, 104, 7, 120.00, 840.00),}\f1\par\pard\plain\ql{\f1\cf0 (3, 105, 2, 500.00, 1000.00);}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 INSERT INTO shipment (order_id, delivery_service_id, ship_date, expected_arrival, actual_arrival, tracking_number, shipping_cost, status) VALUES}\f1\par\pard\plain\ql{\f1\cf0 (1, 1, '2026-01-02', '2026-01-05', '2026-01-06', 'NP001', 50.00, 'Delivered'),}\f1\par\pard\plain\ql{\f1\cf0 (2, 2, '2026-01-03', '2026-01-07', '2026-01-07', 'UP002', 40.00, 'Delivered'),}\f1\par\pard\plain\ql{\f1\cf0 (3, 3, '2026-01-04', '2026-01-08', NULL, 'DU003', 60.00, 'In Transit');}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE VIEW total_purchases_per_supplier AS}\f1\par\pard\plain\ql{\f1\cf0 SELECT s.name AS supplier_name, SUM(poi.line_total) AS total_purchase}\f1\par\pard\plain\ql{\f1\cf0 FROM supplier s}\f1\par\pard\plain\ql{\f1\cf0 JOIN purchase_order po ON s.id = po.supplier_id}\f1\par\pard\plain\ql{\f1\cf0 JOIN purchase_order_item poi ON po.id = poi.purchase_order_id}\f1\par\pard\plain\ql{\f1\cf0 GROUP BY s.name;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE VIEW delayed_shipments AS}\f1\par\pard\plain\ql{\f1\cf0 SELECT sh.id AS shipment_id, sh.tracking_number, sh.expected_arrival, sh.actual_arrival}\f1\par\pard\plain\ql{\f1\cf0 FROM shipment sh}\f1\par\pard\plain\ql{\f1\cf0 WHERE sh.actual_arrival > sh.expected_arrival;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE VIEW order_shipments_info AS}\f1\par\pard\plain\ql{\f1\cf0 SELECT po.id AS order_id, s.name AS supplier_name, ds.name AS delivery_service, sh.status, sh.tracking_number}\f1\par\pard\plain\ql{\f1\cf0 FROM purchase_order po}\f1\par\pard\plain\ql{\f1\cf0 JOIN supplier s ON po.supplier_id = s.id}\f1\par\pard\plain\ql{\f1\cf0 JOIN shipment sh ON po.id = sh.order_id}\f1\par\pard\plain\ql{\f1\cf0 JOIN delivery_service ds ON sh.delivery_service_id = ds.id;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql\f1\par\pard\plain\ql\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE FUNCTION total_order_cost(po_id INT) RETURNS NUMERIC AS $$}\f1\par\pard\plain\ql{\f1\cf0 DECLARE}\f1\par\pard\plain\ql{\f1\cf0     total NUMERIC;}\f1\par\pard\plain\ql{\f1\cf0 BEGIN}\f1\par\pard\plain\ql{\f1\cf0     SELECT SUM(line_total) INTO total}\f1\par\pard\plain\ql{\f1\cf0     FROM purchase_order_item}\f1\par\pard\plain\ql{\f1\cf0     WHERE purchase_order_id = po_id;}\f1\par\pard\plain\ql{\f1\cf0     }\f1\par\pard\plain\ql{\f1\cf0     RETURN total;}\f1\par\pard\plain\ql{\f1\cf0 END;}\f1\par\pard\plain\ql{\f1\cf0 $$ LANGUAGE plpgsql;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE FUNCTION estimated_delivery(ds_id INT, ship_date DATE) RETURNS DATE AS $$}\f1\par\pard\plain\ql{\f1\cf0 DECLARE}\f1\par\pard\plain\ql{\f1\cf0     est DATE;}\f1\par\pard\plain\ql{\f1\cf0 BEGIN}\f1\par\pard\plain\ql{\f1\cf0     IF ds_id = 1 THEN}\f1\par\pard\plain\ql{\f1\cf0         est := ship_date + 5;  }\f1\par\pard\plain\ql{\f1\cf0     ELSIF ds_id = 2 THEN}\f1\par\pard\plain\ql{\f1\cf0         est := ship_date + 7; }\f1\par\pard\plain\ql{\f1\cf0     ELSE}\f1\par\pard\plain\ql{\f1\cf0         est := ship_date + 8;  }\f1\par\pard\plain\ql{\f1\cf0     END IF;}\f1\par\pard\plain\ql{\f1\cf0     }\f1\par\pard\plain\ql{\f1\cf0     RETURN est;}\f1\par\pard\plain\ql{\f1\cf0 END;}\f1\par\pard\plain\ql{\f1\cf0 $$ LANGUAGE plpgsql;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE PROCEDURE mark_order_delivered(po_id INT, actual_delivery DATE) AS $$}\f1\par\pard\plain\ql{\f1\cf0 BEGIN}\f1\par\pard\plain\ql{\f1\cf0     UPDATE purchase_order}\f1\par\pard\plain\ql{\f1\cf0     SET actual_delivery = actual_delivery}\f1\par\pard\plain\ql{\f1\cf0     WHERE id = po_id;}\f1\par\pard\plain\ql{\f1\cf0     }\f1\par\pard\plain\ql{\f1\cf0     UPDATE shipment}\f1\par\pard\plain\ql{\f1\cf0     SET actual_arrival = actual_delivery, status = 'Delivered'}\f1\par\pard\plain\ql{\f1\cf0     WHERE order_id = po_id;}\f1\par\pard\plain\ql{\f1\cf0 END;}\f1\par\pard\plain\ql{\f1\cf0 $$ LANGUAGE plpgsql;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE PROCEDURE add_shipment(order_id INT, ds_id INT, ship_date DATE, cost NUMERIC) AS $$}\f1\par\pard\plain\ql{\f1\cf0 BEGIN}\f1\par\pard\plain\ql{\f1\cf0     INSERT INTO shipment(order_id, delivery_service_id, ship_date, shipping_cost, status)}\f1\par\pard\plain\ql{\f1\cf0     VALUES (order_id, ds_id, ship_date, cost, 'In Transit');}\f1\par\pard\plain\ql{\f1\cf0 END;}\f1\par\pard\plain\ql{\f1\cf0 $$ LANGUAGE plpgsql;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE FUNCTION calc_line_total() RETURNS TRIGGER AS $$}\f1\par\pard\plain\ql{\f1\cf0 BEGIN}\f1\par\pard\plain\ql{\f1\cf0     NEW.line_total := NEW.quantity * NEW.unit_cost;}\f1\par\pard\plain\ql{\f1\cf0     RETURN NEW;}\f1\par\pard\plain\ql{\f1\cf0 END;}\f1\par\pard\plain\ql{\f1\cf0 $$ LANGUAGE plpgsql;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE TRIGGER trg_calc_line_total}\f1\par\pard\plain\ql{\f1\cf0 BEFORE INSERT OR UPDATE ON purchase_order_item}\f1\par\pard\plain\ql{\f1\cf0 FOR EACH ROW}\f1\par\pard\plain\ql{\f1\cf0 EXECUTE FUNCTION calc_line_total();}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE FUNCTION check_ship_date() RETURNS TRIGGER AS $$}\f1\par\pard\plain\ql{\f1\cf0 BEGIN}\f1\par\pard\plain\ql{\f1\cf0     IF NEW.ship_date < (SELECT order_date FROM purchase_order WHERE id = NEW.order_id) THEN}\f1\par\pard\plain\ql{\f1\cf0         RAISE EXCEPTION 'Ship date cannot be before order date';}\f1\par\pard\plain\ql{\f1\cf0     END IF;}\f1\par\pard\plain\ql{\f1\cf0     RETURN NEW;}\f1\par\pard\plain\ql{\f1\cf0 END;}\f1\par\pard\plain\ql{\f1\cf0 $$ LANGUAGE plpgsql;}\f1\par\pard\plain\ql\f1\par\pard\plain\ql{\f1\cf0 CREATE TRIGGER trg_check_ship_date}\f1\par\pard\plain\ql{\f1\cf0 BEFORE INSERT ON shipment}\f1\par\pard\plain\ql{\f1\cf0 FOR EACH ROW}\f1\par\pard\plain\ql{\f1\cf0 EXECUTE FUNCTION check_ship_date();}\f1\par}